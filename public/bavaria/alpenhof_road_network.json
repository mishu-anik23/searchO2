{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": "Alpenhof Eco-Village Farm Road Network",
  "coordinate_system": {
    "reference_resolution": {
      "width": 1920,
      "height": 1080
    },
    "origin": "top-left",
    "axis": {
      "x": "left-to-right (0 to 1920)",
      "y": "top-to-bottom (0 to 1080)"
    }
  },
  "road_type_definitions": {
    "type_a_main_arterial": {
      "name": "Main Road (Primary Arterial)",
      "description": "Heavy packed-clay thoroughfare connecting main entrance gate, central commercial hubs, and western facilities.",
      "default_width_px": 38,
      "width_range_px": [
        24,
        36
      ],
      "surface_material": "packed_clay",
      "traversable_by": [
        "heavy_machinery",
        "tractors",
        "delivery_trucks",
        "visitors",
        "livestock"
      ]
    },
    "type_b_sub_road": {
      "name": "Sub-Road (Service Route)",
      "description": "Medium-width dirt trails connecting working farm zones, pastures, energy assets, and secondary hubs.",
      "default_width_px": 18,
      "width_range_px": [
        14,
        20
      ],
      "surface_material": "compact_dirt",
      "traversable_by": [
        "utility_vehicles",
        "tractors",
        "farm_crew",
        "cattle"
      ]
    },
    "type_c_garden_path": {
      "name": "Garden Path (Pedestrian / Plot Access)",
      "description": "Narrow access trails and interior dividers for orchards, vegetable beds, and flower pollinator gardens.",
      "default_width_px": 14,
      "width_range_px": [
        6,
        10
      ],
      "surface_material": "trodden_turf_gravel",
      "traversable_by": [
        "pedestrians",
        "hand_carts",
        "gardeners"
      ]
    },
    "type_d_bypass_road": {
      "name": "Bypass Road (Pond Loop Connector)",
      "description": "Dedicated secondary route sweeping along the southern perimeter beneath the pond to link the dairy facility with the west hub.",
      "default_width_px": 24,
      "width_range_px": [
        16,
        22
      ],
      "surface_material": "compact_dirt",
      "traversable_by": [
        "utility_vehicles",
        "dairy_transports",
        "farm_crew"
      ]
    }
  },
