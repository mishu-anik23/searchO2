{
  "name": "searcho2-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for searchO2 educational farming simulation game",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": ["searcho2", "gaming", "sustainability", "backend", "express", "postgresql"],
  "author": "",
  "license": "MIT",
