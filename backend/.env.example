# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/searcho2
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=searcho2

# Redis Configuration (Optional - falls back to in-memory if unreachable)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets (Replace in production)
JWT_ACCESS_SECRET=searchO2_super_secret_access_jwt_key_2026_production_grade
JWT_REFRESH_SECRET=searchO2_super_secret_refresh_jwt_key_2026_production_grade
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (optional for dev / mock fallback)
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
