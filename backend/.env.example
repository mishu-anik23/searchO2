# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://searcho2.online

# --- Supabase PostgreSQL (recommended for production) ---
# Dashboard → Project Settings → Database → Connection string → URI
# Prefer "Session mode" pooler (port 6543) for Node/Express.
# Replace [YOUR-PASSWORD] — URL-encode special characters in the password.
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# Direct (port 5432) also works for migrations:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/searcho2
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=searcho2

# Redis optional (in-memory fallback if down)
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_access_secret_min_16_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
